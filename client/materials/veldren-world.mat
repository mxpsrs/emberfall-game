// Veldren world surface for Google Filament 1.77.
// Vertex COLOR.rgb carries the authored tint; COLOR.a carries the integer
// material/atlas slot (0-255) so existing meshes are shared across runtimes.
material {
    name : VeldrenWorld,
    requires : [ color, uv0 ],
    shadingModel : lit,
    blending : masked,
    maskThreshold : 0.38,
    culling : none,
    doubleSided : true,
    parameters : [
        { type : sampler2d, name : atlas },
        { type : float, name : time },
        { type : float, name : night },
        { type : float, name : interior },
        { type : float3, name : mood },
        { type : float, name : bossColor },
        { type : float, name : dissolve },
        { type : float, name : terrainSurface }
    ]
}

fragment {
    vec3 veldrenSrgbToLinear(vec3 color) {
        color = max(color, vec3(0.0));
        vec3 lower = color / 12.92;
        vec3 upper = pow((color + 0.055) / 1.055, vec3(2.4));
        return mix(lower, upper, step(vec3(0.04045), color));
    }

    vec3 veldrenLinearToSrgb(vec3 color) {
        color = max(color, vec3(0.0));
        vec3 lower = color * 12.92;
        vec3 upper = 1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055;
        return mix(lower, upper, step(vec3(0.0031308), color));
    }

    float veldrenHash(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    float veldrenRawNoise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(
            mix(veldrenHash(i), veldrenHash(i + vec2(1.0, 0.0)), f.x),
            mix(veldrenHash(i + vec2(0.0, 1.0)), veldrenHash(i + vec2(1.0, 1.0)), f.x),
            f.y);
    }

    float veldrenDetailVisibility(vec2 p) {
        return 1.0 - smoothstep(0.35, 1.5,
                max(length(dFdx(p)), length(dFdy(p))));
    }

    // Integrate procedural detail that is smaller than a pixel instead of
    // allowing it to sparkle while the camera moves.
    float veldrenNoise(vec2 p) {
        float visible = veldrenDetailVisibility(p);
        return mix(0.5, veldrenRawNoise(p), visible);
    }

    vec4 veldrenAtlas(float id, vec2 uv) {
        float tile = floor(id - 20.0 + 0.01);
        vec2 cell = vec2(mod(tile, 8.0), floor(tile / 8.0));
        vec2 coord = (cell + (vec2(2.0) + fract(uv) * 508.0) / 512.0) / 8.0;
        // Derivatives come from the unwrapped UVs. Clamp both the footprint
        // and sample position to the current tile so trilinear filtering never
        // pulls a neighbouring costume or prop out of the atlas.
        vec2 dx = dFdx(uv) * 508.0 / 4096.0;
        vec2 dy = dFdy(uv) * 508.0 / 4096.0;
        float rho = max(length(dx), length(dy)) * 4096.0;
        float limit = min(1.0, 512.0 / max(rho, 1.0));
        dx *= limit;
        dy *= limit;
        float lod = clamp(log2(max(rho * limit, 1.0)), 0.0, 9.0);
        float inset = min(256.0, max(2.0, exp2(ceil(lod)))) / 4096.0;
        coord = clamp(coord, cell / 8.0 + inset, (cell + 1.0) / 8.0 - inset);
        vec4 texel = textureGrad(materialParams_atlas, coord, dx, dy);
        // The sRGB texture sampler returns linear RGB. Convert it back to the
        // atlas's authored display space for legacy tint composition; the
        // complete result is converted to linear exactly once below.
        texel.rgb = veldrenLinearToSrgb(texel.rgb);
        return texel;
    }

    void material(inout MaterialInputs material) {
        vec4 vertex = getColor();
        // FLOAT4 preserves the authored HDR tint and fractional glow slots.
        float id = vertex.a;
        vec3 world = getWorldPosition();
        vec2 p = world.xz;
        vec3 color = vertex.rgb;
        float alpha = 1.0;
        float roughness = 0.88;

        if (id > 19.5) {
            vec4 texel = veldrenAtlas(id, getUV0());
            color *= texel.rgb;
            alpha = texel.a;
            roughness = 0.78;
        } else if (id > 17.5 && id < 18.5) {
            vec2 grid = p * vec2(2.5, 4.8);
            grid.x += mod(floor(grid.y), 2.0) * 0.5;
            vec2 brick = fract(grid);
            float mortar = smoothstep(0.025, 0.085,
                    min(min(brick.x, 1.0 - brick.x), min(brick.y, 1.0 - brick.y)));
            color *= 0.72 + 0.28 * mortar;
        } else if (id > 16.5 && id < 17.5) {
            float rim = min(min(getUV0().x, 1.0 - getUV0().x), 1.0 - getUV0().y);
            color *= 0.72 + 0.28 * smoothstep(0.0, 0.075, rim);
        } else if (id > 14.5 && id < 16.5) {
            float patches = veldrenNoise(p * 0.42) * 0.6 + veldrenNoise(p * 2.7) * 0.4;
            vec3 grass = mix(vec3(0.19, 0.31, 0.13), vec3(0.44, 0.53, 0.23), patches);
            vec3 dirt = mix(vec3(0.42, 0.34, 0.22), vec3(0.55, 0.46, 0.31), veldrenNoise(p * 4.5));
            if (id > 15.5) {
                dirt = veldrenAtlas(25.0, p * 0.5).rgb * 0.83;
            }
            float edge = min(getUV0().x, 1.0 - getUV0().x);
            float wear = smoothstep(0.01, 0.20,
                    edge + (veldrenNoise(p * 8.0) - 0.5) * 0.10);
            color = mix(grass, dirt, wear);
        } else if (id > 0.5 && id < 1.5) {
            // Terrain is deliberately sampler-free. Broad, derivative-filtered
            // color variation cannot alias or crawl as the camera moves.
            float patches = veldrenNoise(p * 0.055) * 0.72 + veldrenNoise(p * 0.015) * 0.28;
            vec3 grass = mix(vec3(0.23, 0.32, 0.17), vec3(0.39, 0.46, 0.26), patches);
            color = grass;
            float forest = smoothstep(449.0, 490.0, p.y) * smoothstep(135.0, 175.0, p.x);
            float mountain = smoothstep(548.0, 610.0, p.x) * (1.0 - smoothstep(417.0, 465.0, p.y));
            vec3 woodland = mix(vec3(0.17, 0.29, 0.19), vec3(0.29, 0.39, 0.25), patches);
            vec3 moor = mix(vec3(0.27, 0.30, 0.20), vec3(0.42, 0.43, 0.28), patches);
            color = mix(mix(color, woodland, forest), moor, mountain);
            float bank = getUV0().y > 0.5 ? 1.0 - smoothstep(0.4, 3.8, getUV0().x) : 0.0;
            vec3 earth = mix(vec3(0.34, 0.27, 0.19), vec3(0.46, 0.37, 0.25), patches);
            float scree = mountain * smoothstep(0.58, 0.82, veldrenNoise(p * 0.23)) * 0.42;
            color = mix(color, earth, max(max(bank * 0.82,
                    (1.0 - smoothstep(0.78, 0.97, getWorldNormalVector().y)) * 0.7), scree));
            // Terrain vertices carry road coverage in COLOR.r, paving in
            // COLOR.g and quarry/cut-rock coverage in COLOR.b. The old
            // Filament material discarded these channels, turning the entire
            // world into grass even though roads still existed in world data.
            if (getUV0().y > 0.5) {
                vec3 dirt = mix(vec3(0.40, 0.335, 0.25), vec3(0.47, 0.405, 0.31), patches);
                vec3 paving = mix(vec3(0.46, 0.47, 0.43), vec3(0.59, 0.58, 0.51), patches);
                vec3 cutRock = mix(vec3(0.43, 0.44, 0.40), vec3(0.64, 0.63, 0.56), patches);
                float roadMask = smoothstep(0.05, 0.90, clamp(vertex.r, 0.0, 1.0));
                float pavingMask = smoothstep(0.05, 0.90, clamp(vertex.g, 0.0, 1.0));
                float quarryMask = smoothstep(0.05, 0.90, clamp(vertex.b, 0.0, 1.0));
                color = mix(color, dirt, roadMask);
                color = mix(color, paving, pavingMask);
                color = mix(color, cutRock, quarryMask);
            }
            roughness = 1.0;
        } else if (id > 1.5 && id < 2.5) {
            color = mix(vec3(0.28, 0.285, 0.255), vec3(0.39, 0.375, 0.31), veldrenNoise(p * 0.65));
        } else if (id > 2.5 && id < 3.5) {
            vec2 grid = fract(p * 0.55);
            float joint = smoothstep(0.025, 0.09, min(min(grid.x, 1.0 - grid.x), min(grid.y, 1.0 - grid.y)));
            color = mix(vec3(0.34, 0.33, 0.29), vec3(0.52, 0.50, 0.43), joint);
        } else if (id > 3.5 && id < 4.5) {
            float flow = veldrenNoise(p * 0.18 + vec2(materialParams.time * 0.015, -materialParams.time * 0.012));
            float ripple = sin(dot(p, vec2(0.65, 0.23)) + materialParams.time * 0.6) * 0.018;
            color = mix(vec3(0.055, 0.20, 0.22), vec3(0.12, 0.30, 0.29), flow) + ripple;
            roughness = 0.28;
        } else if (id > 4.5 && id < 5.5) {
            color *= 0.78 + 0.18 * veldrenNoise(vec2(p.x * 22.0, p.y * 1.6));
        } else if (id > 5.5 && id < 6.5) {
            vec2 tile = vec2(world.z * 5.0, (world.x + world.y) * 6.0);
            tile.x += mod(floor(tile.y), 2.0) * 0.5;
            float lip = smoothstep(0.02, 0.15,
                    min(fract(tile).x, fract(tile).y));
            color *= mix(0.974, 0.72 + 0.28 * lip,
                    veldrenDetailVisibility(tile));
        }

        if (materialParams.bossColor > 1.5) {
            color = vec3(max(color.b, color.g * 0.95), color.r * 0.45, color.r * 0.35);
        }
        if (materialParams.dissolve > 0.0 &&
                veldrenHash(floor(world.xz * 21.0) + floor(world.y * 19.0)) < materialParams.dissolve) {
            alpha = 0.0;
        }

        // Veldren's palettes, texture atlas and procedural colors were authored
        // in display space. Filament materials consume linear, premultiplied
        // color, so convert once after the legacy composition is complete.
        vec3 linearColor = veldrenSrgbToLinear(color);
        prepareMaterial(material);
        material.baseColor = vec4(linearColor * alpha, alpha);
        material.roughness = roughness;
        material.metallic = 0.0;
        material.reflectance = mix(0.24, 0.0, materialParams.terrainSurface);
        float ambient = mix(0.075, 0.12, materialParams.night) + materialParams.interior * 0.08;
        float terrainAmbient = mix(0.18, 0.34, materialParams.night);
        float glow = id > 18.5 && id < 19.5
                ? (id > 19.15 ? mix(0.12, 0.85, materialParams.night) : 0.72)
                : mix(ambient, terrainAmbient, materialParams.terrainSurface);
        material.emissive = vec4(linearColor * materialParams.mood * glow, 0.0);
    }
}
