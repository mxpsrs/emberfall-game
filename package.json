{
  "name": "veldren",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "accounts:reset": "node --env-file-if-exists=.env.reset.local scripts/reset-accounts.mjs",
    "accounts:reset:check": "node tests/server/global-reset.mjs",
    "dev": "vite",
    "icons:build": "node scripts/assets/build-icons.mjs",
    "filament:assets": "node scripts/assets/build-filament-assets.mjs",
    "filament:verify": "node tests/rendering/renderer-filament.cjs && node tests/rendering/filament-character-parity.cjs && node tests/rendering/filament-runtime.cjs",
    "native:build": "make -C native wasm",
    "native:test": "make -C native test wasm-test && node tests/native/native-runtime.mjs",
    "check": "node scripts/check-source.mjs",
    "test": "node scripts/check-game.mjs",
    "test:editor": "node scripts/check-game.mjs editor",
    "test:rendering": "node scripts/check-game.mjs rendering",
    "test:ranged": "node scripts/check-game.mjs ranged-performance.cjs",
    "release:package": "node scripts/release/package-release.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0"
  }
}
